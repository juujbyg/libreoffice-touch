#!/bin/sh
# LibreOffice for Ubuntu Touch (unofficial port): runs the official LibreOffice (GTK3, native Wayland on Lomiri),
# downloaded on first use, with a phone-sized interface.
# Usage: office [writer|calc|impress|draw|math|base] [file or URI...]
#
# Sizing: LO_DPI (LibreOffice's own drawing: toolbars, document, status bar; 96 = desktop) and
# LO_TEXT_SCALE (text in menus and dialogs). GDK_SCALE has no effect on Lomiri.
ID=libreoffice.juujbyg
APP_DIR=$(cd "$(dirname "$0")/.." && pwd)
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/$ID"
PROFILE="${XDG_CONFIG_HOME:-$HOME/.config}/$ID/profile"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/$ID"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "$CACHE"

program() { for p in "$DATA"/libreoffice/opt/*/program; do [ -x "$p/soffice.bin" ] && { echo "$p"; return; }; done; }

# First use: the installer screen downloads LibreOffice from The Document Foundation.
# The screen stays open while LibreOffice starts, because Lomiri closes an app that is left
# with no window; it closes itself a little later.
PROG=$(program)
if [ -z "$PROG" ]; then
  OFFICE_DATA="$DATA" qmlscene "$APP_DIR/installer/Main.qml" &
  screen=$!
  while [ -z "$PROG" ] && kill -0 "$screen" 2>/dev/null; do sleep 1; PROG=$(program); done
  [ -n "$PROG" ] || PROG=$(program)
  [ -n "$PROG" ] || exit 1
fi

# First run: a profile with the phone defaults (large icons, Writer at page width, slide and
# page lists hidden, sidebars folded, and the PhoneView macro that opens files at page width).
fresh=0
if [ ! -d "$PROFILE/user" ]; then
  mkdir -p "$PROFILE" && cp -r "$APP_DIR/profile" "$PROFILE/user" && chmod -R u+w "$PROFILE/user"
  fresh=1
fi

export LD_LIBRARY_PATH="$PROG:$APP_DIR/lib"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" GDK_BACKEND=wayland SAL_USE_VCLPLUGIN=gtk3
# Base opens with its Database Wizard, which LibreOffice draws itself in a fixed-size window that
# cannot scroll: at text scale 1.8 it is ~1650 px wide, so Base uses smaller text to fit 1080 px.
case "$1" in base) text=1.2;; *) text=1.8;; esac
export SAL_FORCEDPI="${LO_DPI:-192}" GDK_DPI_SCALE="${LO_TEXT_SCALE:-$text}"
# Finger-sized buttons, menus and scrollbars, and the look of dialog sheets (share/themes/LibreTouch).
export GTK_THEME="${LO_GTK_THEME:-LibreTouch}" XDG_DATA_DIRS="$APP_DIR/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# Lomiri's on-screen keyboard through the Maliit GTK input module (lib/, from Ubuntu's archive).
printf '"%s"\n"Maliit" "Maliit Input Method" "maliit" "/usr/share/locale" "en:ja:ko:zh:*"\n' \
  "$APP_DIR/lib/gtk-3.0/immodules/im-maliit.so" > "$CACHE/immodules.cache"
export GTK_IM_MODULE=Maliit GTK_IM_MODULE_FILE="$CACHE/immodules.cache"
# Dialogs as phone sheets: Lomiri opens child windows as if 640x480 and never re-centres them,
# so libnoparent.so maximises every dialog instead and centres small ones as a card.
export LD_PRELOAD="$APP_DIR/lib/libnoparent.so${LD_PRELOAD:+:$LD_PRELOAD}"
unset GDK_GL GDK_DEBUG GDK_SCALE
# No splash screen: Lomiri stops an app whose first window closes before the next one opens.
case "$1" in writer|calc|impress|draw|math|base) m="--$1"; shift;; *) m="";; esac
# Start-up log: only the settings this script makes (not the whole environment, which can hold
# tokens), readable by the user alone.
( umask 077; { date; env | grep -E '^(SAL_|GDK_|GTK_|LO_|LD_PRELOAD=|WAYLAND_DISPLAY=)' | sort; } > "$CACHE/last.log" 2>&1 )
# A fresh profile makes soffice.bin exit with 81 after first-run setup: start it again. That setup
# replaces the profile's Basic folder with LibreOffice's default one, so the PhoneView macro is put
# back, once, before the restart (only into the profile made above, never over the user's macros).
while :; do
  "$PROG/soffice.bin" $m --nologo --norestore -env:UserInstallation="file://$PROFILE" "$@" 2>>"$CACHE/last.log"
  rc=$?
  [ "$rc" -eq 81 ] || exit "$rc"
  if [ "$fresh" = 1 ]; then
    cp -r "$APP_DIR/profile/basic/." "$PROFILE/user/basic/" && chmod -R u+w "$PROFILE/user/basic"
    fresh=0
  fi
done
